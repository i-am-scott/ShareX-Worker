{
	"name": "sharex-worker",
	"version": "1.0.5",
	"homepage": "https://github.com/aStonePenguin/ShareX-Worker",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "npx wrangler types && run-s type-check \"build-only {@}\" --",
		"preview": "npm run build && wrangler dev",
		"build-only": "cross-env NODE_OPTIONS=--max-old-space-size=6144 vite build",
		"generate-types": "wrangler types",
		"type-check": "vue-tsc --build",
		"deploy": "npm run build && wrangler deploy"
	},
	"dependencies": {
		"@cf-wasm/resvg": "^0.3.5",
		"@lucide/vue": "^1.28.0",
		"@tanstack/vue-table": "^8.21.2",
		"@vscode/vscode-languagedetection": "^1.0.23",
		"@vueuse/core": "^14.4.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "^4.7.4",
		"mime-types": "^3.0.2",
		"moment": "^2.30.1",
		"monaco-editor": "^0.56.0",
		"motion-v": "^2.3.0",
		"pinia": "^4.0.2",
		"reka-ui": "^2.1.1",
		"tailwind-merge": "^3.0.2",
		"tailwindcss-animate": "^1.0.7",
		"vee-validate": "^4.15.0",
		"vue": "^3.5.13",
		"vue-inner-image-zoom": "^3.0.1",
		"vue-router": "^4.5.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.48.0",
