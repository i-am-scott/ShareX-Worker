		"@types/node": "^22.13.11",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/tsconfig": "^0.9.1",
		"autoprefixer": "^10.4.21",
		"cross-env": "^10.1.0",
		"npm-run-all2": "^8.0.4",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.9.3",
		"vidstack": "^1.12.13",
		"vite": "^6.1.0",
		"vite-plugin-vue-devtools": "^8.2.1",
		"vue-tsc": "^3.3.8",
